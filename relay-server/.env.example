# 合鸣中继服务器配置

# 服务器端口
PORT=3001

# CORS 允许的源（逗号分隔，* 表示所有）
CORS_ORIGINS=*

# 共享认证密钥（强烈建议生产环境设置）。
# 设置后：
#   - Socket.IO 握手要求 auth.token 与 key 一致（不匹配则拒绝连接）
#   - GET /devices 要求 Authorization: Bearer <key>
# 客户端（桌面端/移动端）需配置相同的 key 作为 relay token。
# 未设置时保持向后兼容，但会打印安全警告。
# RELAY_AUTH_KEY=

# 离线消息过期时间（毫秒，默认 24 小时）
OFFLINE_MESSAGE_EXPIRY=86400000

# 日志级别
LOG_LEVEL=info
