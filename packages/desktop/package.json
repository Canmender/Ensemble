{
  "name": "@multiagent/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "MultiAgent 桌面应用（Electron 壳）",
  "main": "./dist/main/index.cjs",
  "scripts": {
    "build:main": "node scripts/build.mjs",
    "build:preload": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "pnpm build && cross-env RENDERER_URL=http://localhost:5173 electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "pnpm build && pnpm --filter @multiagent/web build && electron-builder --win"
  },
  "dependencies": {
    "@multiagent/server": "workspace:*",
    "@multiagent/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.0"
  }
}
