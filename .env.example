# =============================================================================
# 合鸣（Ensemble）环境变量配置
# =============================================================================
# 使用方式: 复制此文件为 .env 并按需修改
#   cp .env.example .env

# === Desktop Server ===

# 桌面端本地服务端口（headless 模式默认 8787；桌面版 prod 随机端口）
# PORT=8787

# 固定 API key（headless/Docker 部署）。
# 配置后：
#   - 作为 HTTP 与 WebSocket 的统一访问凭证（Authorization: Bearer <key>）
#   - /api/ws-token 端点被禁用（防止公网绑定 0.0.0.0 时 token 被任意获取）
# 桌面版（Electron）无需配置 —— 每次启动自动生成随机 session token。
# ENSEMBLE_API_KEY=

# === Relay Server ===

# Relay 服务监听端口（默认 8888）
RELAY_PORT=8888

# CORS 允许的来源，多个用逗号分隔，* 表示允许所有
CORS_ORIGINS=*

# 离线消息过期时间（毫秒），默认 86400000（24 小时）
OFFLINE_MESSAGE_EXPIRY=86400000

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# === Nginx（可选，production profile） ===

# HTTP 端口（默认 80）
HTTP_PORT=80

# HTTPS 端口（默认 443）
HTTPS_PORT=443
