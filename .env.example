# 后端服务端口
PORT=8787

# SQLite 数据库路径（相对 server 包根目录）
DB_PATH=data/multiagent.db

# 配置目录（agent YAML + workflow JSON 的根）
CONFIG_DIR=../../config

# Hermes 可执行文件（绝对路径或 PATH 名；不设置则默认用 PATH 中的 hermes）
# HERMES_EXECUTABLE=C:/Users/ADMIN/AppData/Local/hermes/hermes-agent/venv/Scripts/hermes.exe

# 是否通过 WSL 调用 hermes（本机原生 Windows 装好时保持 false）
# HERMES_USE_WSL=false
# HERMES_WSL_DISTRO=Ubuntu
