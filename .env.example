# =============================================================================
# 合鸣（Ensemble）环境变量配置
# =============================================================================
# 使用方式: 复制此文件为 .env 并按需修改
#   cp .env.example .env

# === Relay Server ===

# Relay 服务监听端口（默认 8888）
RELAY_PORT=8888

# CORS 允许的来源，多个用逗号分隔，* 表示允许所有
CORS_ORIGINS=*

# 离线消息过期时间（毫秒），默认 86400000（24 小时）
OFFLINE_MESSAGE_EXPIRY=86400000

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# === Nginx（可选，production profile） ===

# HTTP 端口（默认 80）
HTTP_PORT=80

# HTTPS 端口（默认 443）
HTTPS_PORT=443
