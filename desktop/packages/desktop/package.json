{
  "name": "@ensemble/desktop",
  "version": "0.7.9",
  "private": true,
  "description": "合鸣 桌面应用（Electron 壳）",
  "main": "./dist/main/index.cjs",
  "scripts": {
    "build:main": "node scripts/build.mjs",
    "build:preload": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "pnpm build && cross-env RENDERER_URL=http://localhost:5173 electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "node scripts/gen-icon.mjs && pnpm build && pnpm --filter @ensemble/web build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@ensemble/server": "workspace:*",
    "@ensemble/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.0"
  }
}