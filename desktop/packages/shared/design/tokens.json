        "200": {
          "$type": "color",
          "$value": "#E2E8F0"
        },
        "300": {
          "$type": "color",
          "$value": "#94A3B8"
        },
        "600": {
          "$type": "color",
          "$value": "#334155"
        },
        "700": {
          "$type": "color",
          "$value": "#64748B"
        },
        "800": {
          "$type": "color",
          "$value": "#1E293B"
        },
        "850": {
          "$type": "color",
          "$value": "#0F172A"
        },
        "900": {
          "$type": "color",
          "$value": "#171B23"
        }
      }
    },
    "radius": {
      "sm": {
        "$type": "dimension",
        "$value": "6px"
      },
      "md": {
        "$type": "dimension",
        "$value": "10px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "14px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "20px"
      }
    },
    "spring": {
      "$description": "弹簧动画参数 damping/stiffness（调研第二轮核实值）",
      "universal": {
        "damping": 25,
        "stiffness": 250
      },
      "snappy": {
        "damping": 15,
        "stiffness": 400
      },
      "gentleEntry": {
        "damping": 30,
        "stiffness": 200
      }
    }
  },
  "semantic": {
    "$description": "语义 token：按主题分组；值统一为 { $value: 别名引用 } 规范形态（W3C DTCG）",
    "light": {
      "bg": {
        "$type": "color",
        "$value": "{primitive.color.slate.100}"
      },
      "surface": {
        "$type": "color",
        "$value": "{primitive.color.slate.50}"
      },
      "surface1": {
        "$type": "color",
        "$value": "{primitive.color.slate.25}"
      },
      "surface2": {
        "$type": "color",
        "$value": "{primitive.color.slate.50}"
      },
      "border": {
        "$type": "color",
        "$value": "{primitive.color.slate.200}"
      },
      "fg": {
        "$type": "color",
        "$value": "{primitive.color.slate.900}"
      },
      "muted": {
        "$type": "color",
        "$value": "{primitive.color.slate.700}"
      },
      "primary": {
        "$type": "color",
        "$value": "{primitive.color.xuan.500}"
      },
      "primary-fg": {
        "$type": "color",
        "$value": "{primitive.color.slate.50}"
      },
      "accent": {
        "$type": "color",
        "$value": "{primitive.color.xuan-indigo.500}"
      },
      "destructive": {
        "$type": "color",
        "$value": "{primitive.color.red.500}"
      },
      "ring": {
        "$type": "color",
        "$value": "{primitive.color.xuan.500}"
      },
      "success": {
        "$type": "color",
        "$value": "{primitive.color.green.400}"
      },
      "warning": {
        "$type": "color",
        "$value": "{primitive.color.amber.500}"
      }
    },
    "dark": {
      "bg": {
        "$type": "color",
        "$value": "{primitive.color.slate.850}"
      },
      "surface": {
        "$type": "color",
        "$value": "{primitive.color.slate.800}"
      },
      "surface1": {
        "$type": "color",
        "$value": "{primitive.color.slate.800}"
      },
      "surface2": {
        "$type": "color",
        "$value": "{primitive.color.slate.600}"
      },
      "border": {
        "$type": "color",
        "$value": "{primitive.color.slate.600}"
      },
      "fg": {
        "$type": "color",
        "$value": "{primitive.color.slate.25}"
      },
      "muted": {
