  "$description": "合鸣三层设计 token 单源（primitive → semantic → component）。消费方式见 build.mjs：构建期输出 web CSS vars 与 RN hex 常量，双端同源。",
  "primitive": {
    "color": {
      "indigo": {
        "100": {
          "$type": "color",
          "$value": "#D9DCE3"
        },
        "600": {
          "$type": "color",
          "$value": "#8C7AE6"
        },
        "900": {
          "$type": "color",
          "$value": "#2C2A72"
        }
      },
      "blue": {
