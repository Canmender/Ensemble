{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "合鸣三层设计 token 单源（primitive → semantic → component）。消费方式见 build.mjs：构建期输出 web CSS vars 与 RN hex 常量，双端同源。",
  "primitive": {
    "color": {
      "indigo": {
        "900": { "$type": "color", "$value": "#2C2A72" },
        "600": { "$type": "color", "$value": "#8C7AE6" },
        "100": { "$type": "color", "$value": "#D9DCE3" }
      },
      "blue": {
        "500": { "$type": "color", "$value": "#0C8CEB" },
        "400": { "$type": "color", "$value": "#38BDF8" }
      },
      "green": {
        "500": { "$type": "color", "$value": "#16A34A" },
        "400": { "$type": "color", "$value": "#34D399" },
        "300": { "$type": "color", "$value": "#22C55E" }
      },
      "amber": {
        "500": { "$type": "color", "$value": "#F59E0B" },
        "400": { "$type": "color", "$value": "#FBBF24" }
      },
      "red": {
        "500": { "$type": "color", "$value": "#DC2626" },
        "400": { "$type": "color", "$value": "#F87171" }
      },
      "slate": {
        "900": { "$type": "color", "$value": "#171B23" },
        "700": { "$type": "color", "$value": "#64748B" },
        "200": { "$type": "color", "$value": "#E2E8F0" },
        "100": { "$type": "color", "$value": "#F4F6F9" },
        "50": { "$type": "color", "$value": "#FFFFFF" },
        "850": { "$type": "color", "$value": "#0F172A" },
        "800": { "$type": "color", "$value": "#1E293B" },
        "600": { "$type": "color", "$value": "#334155" },
        "300": { "$type": "color", "$value": "#94A3B8" },
        "25": { "$type": "color", "$value": "#FAFBFC" }
      }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "6px" },
      "md": { "$type": "dimension", "$value": "10px" },
      "lg": { "$type": "dimension", "$value": "14px" },
      "xl": { "$type": "dimension", "$value": "20px" }
    },
    "spring": {
      "$description": "弹簧动画参数 damping/stiffness（调研第二轮核实值）",
      "universal": { "damping": 25, "stiffness": 250 },
      "snappy": { "damping": 15, "stiffness": 400 },
      "gentleEntry": { "damping": 30, "stiffness": 200 }
    }
  },
  "semantic": {
    "$description": "语义 token：按主题分组；值统一为 { $value: 别名引用 } 规范形态（W3C DTCG）",
    "light": {
      "bg": { "$type": "color", "$value": "{primitive.color.slate.100}" },
      "surface": { "$type": "color", "$value": "{primitive.color.slate.50}" },
      "surface1": { "$type": "color", "$value": "{primitive.color.slate.25}" },
      "surface2": { "$type": "color", "$value": "{primitive.color.slate.50}" },
      "border": { "$type": "color", "$value": "{primitive.color.slate.200}" },
      "fg": { "$type": "color", "$value": "{primitive.color.slate.900}" },
      "muted": { "$type": "color", "$value": "{primitive.color.slate.700}" },
      "primary": { "$type": "color", "$value": "{primitive.color.blue.500}" },
      "primary-fg": { "$type": "color", "$value": "{primitive.color.slate.50}" },
      "accent": { "$type": "color", "$value": "{primitive.color.green.500}" },
      "destructive": { "$type": "color", "$value": "{primitive.color.red.500}" },
      "ring": { "$type": "color", "$value": "{primitive.color.blue.500}" },
      "success": { "$type": "color", "$value": "{primitive.color.green.400}" },
      "warning": { "$type": "color", "$value": "{primitive.color.amber.500}" }
    },
    "dark": {
      "bg": { "$type": "color", "$value": "{primitive.color.slate.850}" },
      "surface": { "$type": "color", "$value": "{primitive.color.slate.800}" },
      "surface1": { "$type": "color", "$value": "{primitive.color.slate.800}" },
      "surface2": { "$type": "color", "$value": "{primitive.color.slate.600}" },
      "border": { "$type": "color", "$value": "{primitive.color.slate.600}" },
      "fg": { "$type": "color", "$value": "{primitive.color.slate.25}" },
      "muted": { "$type": "color", "$value": "{primitive.color.slate.300}" },
      "primary": { "$type": "color", "$value": "{primitive.color.blue.400}" },
      "primary-fg": { "$type": "color", "$value": "{primitive.color.slate.850}" },
      "accent": { "$type": "color", "$value": "{primitive.color.green.300}" },
      "destructive": { "$type": "color", "$value": "{primitive.color.red.400}" },
      "ring": { "$type": "color", "$value": "{primitive.color.blue.400}" },
      "success": { "$type": "color", "$value": "{primitive.color.green.400}" },
      "warning": { "$type": "color", "$value": "{primitive.color.amber.400}" }
    }
  }
}
