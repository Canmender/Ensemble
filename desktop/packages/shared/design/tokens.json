          "$type": "color",
          "$value": "#8B8F98"
        },
        "500": {
          "$type": "color",
          "$value": "#3B3F4A"
        }
      },
      "xuan-indigo": {
        "400": {
          "$type": "color",
          "$value": "#B4ACF8"
        },
