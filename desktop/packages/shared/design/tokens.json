          "$type": "color",
          "$value": "#FBBF24"
        },
        "500": {
          "$type": "color",
          "$value": "#F59E0B"
        }
      },
      "red": {
        "400": {
          "$type": "color",
          "$value": "#F87171"
        },
        "500": {
          "$type": "color",
          "$value": "#DC2626"
        }
      },
      "slate": {
        "25": {
          "$type": "color",
          "$value": "#FAFBFC"
        },
        "50": {
          "$type": "color",
          "$value": "#FFFFFF"
        },
        "100": {
          "$type": "color",
          "$value": "#F4F6F9"
