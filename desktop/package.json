{
  "name": "ensemble",
  "private": true,
  "version": "0.4.0",
  "description": "多 Agent 协作平台 —— 接入 Hermes Agent 与 Claude Code，提供前端编排与实时协作",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @ensemble/server dev",
    "dev:web": "pnpm --filter @ensemble/web dev",
    "dev:desktop": "pnpm --filter @ensemble/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "smoke": "pnpm --filter @ensemble/cli smoke",
    "cli": "pnpm --filter @ensemble/cli cli"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
